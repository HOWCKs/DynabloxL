    <!-- =====================================================================
         FORGED — performance console.

         Near-black carbon chassis with a single hot accent. The accent is the ONLY
         saturated colour on a surface, so it always means "energised": mode engaged,
         control active, meter in the red. Mode tints reuse the semantic slots
         (success/warning/danger) so ECO/TURBO/BATTLE read without a legend.
         ===================================================================== -->
    <color name="fg_void">#FF07080A</color>
    <color name="fg_base">#FF0C0E11</color>
    <color name="fg_plate">#FF14171C</color>
