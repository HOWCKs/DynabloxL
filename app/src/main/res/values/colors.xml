    <color name="clay_text_2">#FFC3B2A8</color>
    <color name="clay_text_3">#FF8B7A70</color>
    <color name="clay_oxide">#FFE0724A</color>
    <color name="clay_oxide_deep">#FF8C3F27</color>
    <color name="clay_slate">#FF6E8B94</color>
    <color name="clay_sage">#FF7FA88A</color>
    <color name="clay_kiln">#FFD9A15C</color>
