    <!-- =====================================================================
         CLAY MORPHIST — pressed matter.

         The machined palette above is cold on purpose (graphite + petrol reads as
         anodised metal). Clay needs the opposite bias: every neutral carries a red/ochre
         component, because unfired matter is never grey. The accents are pigments —
         oxide, slate and kiln — not LEDs, so nothing glows.
         ===================================================================== -->
    <color name="clay_void">#FF16110F</color>
    <color name="clay_base">#FF1E1815</color>
    <color name="clay_raised">#FF29211D</color>
    <color name="clay_raised_hi">#FF352A25</color>
