<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Studio-lit graphite backdrop: soft top glow, deep bottom, faint horizon line. -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#FF12181C"
                android:centerColor="#FF0E1215"
                android:endColor="#FF070A0C"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.22"
                android:centerY="0.04"
                android:gradientRadius="900"
                android:startColor="#2A1C6280"
                android:centerColor="#12143A4C"
                android:endColor="#00000000"
                android:type="radial" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.9"
                android:centerY="0.95"
                android:gradientRadius="700"
                android:startColor="#1434A9FF"
                android:endColor="#00000000"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
