<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- White ceramic backdrop for the light theme. -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#FFFBF9F4"
                android:centerColor="#FFF4F1EA"
                android:endColor="#FFE9E4D9"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.2"
                android:centerY="0.05"
                android:gradientRadius="900"
                android:startColor="#221A6CA6"
                android:endColor="#00000000"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
